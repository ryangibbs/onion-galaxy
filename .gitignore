# Dependencies
node_modules/

# Build output (published to npm, never committed)
dist/
*.tsbuildinfo

# Generated galaxy maps. These contain the full file structure of whatever project was mapped,
# which may be private, so they are never committed.
out/
galaxy.html
*.galaxy.html
*.galaxy.json

# Packed tarballs (`pnpm pack`)
*.tgz

# Logs and debug output
*.log
npm-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Environment and secrets
.env
.env.*
.npmrc

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local Claude Code settings
.claude/
