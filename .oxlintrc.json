{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "fixture/**"
  ],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__threeObj",
          "__lineObj",
          "__photonsObj"
        ]
      }
    ]
  }
}
